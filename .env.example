# HeartSync configuration. Copy to .env and fill in. NEVER commit real values.
# Every value below is a placeholder.

# --- Core -------------------------------------------------------------------
APP_ENV=development                 # development | test | production
BASE_URL=http://localhost:8000      # public URL, used in emails and payment redirects
SECRET_KEY=                         # REQUIRED in production: 32+ random chars, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
DATABASE_PATH=./var/heartsync.db
MEDIA_ROOT=./var/media              # private directory, NOT served statically
COOKIE_SECURE=false                 # set true behind HTTPS (required in production)
TRUST_PROXY=0                       # set 1 only behind a trusted reverse proxy that sets X-Forwarded-For
SESSION_DAYS=14
REQUIRE_PHONE_VERIFICATION=true
REQUIRE_STAFF_MFA=                  # empty = on in production, off in dev. Staff must enable 2FA to use /admin
MFA_ENCRYPTION_KEY=                 # optional Fernet key for 2FA secrets; if empty, derived from SECRET_KEY
                                    #   (then rotating SECRET_KEY invalidates 2FA enrolments). Generate with:
                                    #   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MAX_UPLOAD_BYTES=8388608
SIGNED_URL_TTL=600

# --- Branding -----------------------------------------------------------------
BRAND_NAME=HeartSync
BRAND_TAGLINE=Meaningful connections, made with care.
BRAND_PRIMARY=#4a1d3f
BRAND_ACCENT=#d9577a
SUPPORT_EMAIL=support@example.com

# --- SMS (phone verification) ---------------------------------------------------
# console = development only (codes go to /dev/outbox, nothing is sent; refused in production)
SMS_PROVIDER=console                # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email ------------------------------------------------------------------------
EMAIL_PROVIDER=console              # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HeartSync <no-reply@example.com>

# --- Payments ---------------------------------------------------------------------
# mock = development only simulated checkout (refused in production)
PAYMENT_PROVIDER=mock               # mock | stripe | none (none = launch with free plan only)
MOCK_PAYMENT_WEBHOOK_SECRET=        # optional in dev; random if empty
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=                  # Stripe Price ID for the Plus monthly plan
STRIPE_PRICE_PREMIUM=               # Stripe Price ID for the Premium monthly plan
# PLANS_JSON=                       # optional: override plan quotas/prices (see heartsync/config.py)

# --- Writing suggestions (optional) -----------------------------------------------
# rules = local templates, no data leaves the server. anthropic = Claude API (only if the key is set;
# falls back to rules on any error). Check provider terms and update the privacy policy before enabling.
AI_PROVIDER=rules                   # rules | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# --- Admin bootstrap (used only by scripts/create_admin.py) ----------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
